<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>LeAccess</AssemblyName>
    <Product>Last Epoch Accessibility Mod</Product>
    <Version>0.2.8</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>LeAccess</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Game paths -->
    <GameDir Condition="'$(GameDir)' == ''">D:\games\steam\steamapps\common\Last Epoch</GameDir>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
    <InteropDir>$(BepInExDir)\interop</InteropDir>
    <PluginsDir>$(BepInExDir)\plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeAccess.InteropRepair\LeAccess.InteropRepair.csproj"
                      ReferenceOutputAssembly="false" AdditionalProperties="GameDir=$(GameDir)" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Game interop references -->
  <ItemGroup>
    <Reference Include="LE">
      <HintPath>$(InteropDir)\LE.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LE.UI.Controls">
      <HintPath>$(InteropDir)\LE.UI.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LE.PCG">
      <HintPath>$(InteropDir)\LE.PCG.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Base type of the Rage of Morditas network object (reference/rage-of-morditas.md). -->
    <Reference Include="LE.Networking.Core">
      <HintPath>$(InteropDir)\LE.Networking.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(InteropDir)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(InteropDir)\Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Heathen.ScreenKeyboard">
      <HintPath>$(InteropDir)\Heathen.ScreenKeyboard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FmodShared">
      <HintPath>$(InteropDir)\FmodShared.dll</HintPath>
      <Private>false</Private>
      <Aliases>FmodGame</Aliases>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(InteropDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(InteropDir)\UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DialogueSystem">
      <HintPath>$(InteropDir)\DialogueSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(InteropDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(InteropDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(InteropDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(InteropDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(InteropDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(InteropDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Localization">
      <HintPath>$(InteropDir)\Unity.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(InteropDir)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExDir)\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(InteropDir)\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(InteropDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(InteropDir)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Tolk screen reader library -->
  <ItemGroup>
    <Reference Include="TolkDotNet">
      <HintPath>..\references\tolk\TolkDotNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Translations\*.json" LogicalName="LeAccess.Translations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="MapSections\*.json" LogicalName="LeAccess.MapSections.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="LeAccess.Sounds.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Sounds\Loops\*.wav" LogicalName="LeAccess.Sounds.Loops.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Sounds\D2R-LICENSE.txt" LogicalName="LeAccess.Sounds.D2R-LICENSE.txt" />
    <EmbeddedResource Include="Accessibility\MapSections\tent-canopies.json" LogicalName="LeAccess.TentCanopies.json" />
    <None Update="Translations\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy DLL to plugins folder after build -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="'$(SkipPluginDeployment)' != 'true'">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(PluginsDir)\LeAccess" />
    <!-- Keep user-edited catalogs; bundled resources provide new default keys. -->
    <ItemGroup>
      <PluginTranslation Include="$(TargetDir)Translations\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginTranslation)" DestinationFolder="$(PluginsDir)\LeAccess\Translations"
          Condition="!Exists('$(PluginsDir)\LeAccess\Translations\%(PluginTranslation.Filename)%(PluginTranslation.Extension)')" />
    <Copy SourceFiles="$(TargetDir)TolkDotNet.dll" DestinationFolder="$(PluginsDir)\LeAccess" Condition="Exists('$(TargetDir)TolkDotNet.dll')" />
    <!-- Copy native Tolk DLLs -->
    <Copy SourceFiles="..\references\tolk\Tolk.dll" DestinationFolder="$(PluginsDir)\LeAccess" />
    <Copy SourceFiles="..\references\tolk\nvdaControllerClient64.dll" DestinationFolder="$(PluginsDir)\LeAccess" />
    <!-- Copy NAudio DLLs -->
    <Copy SourceFiles="$(TargetDir)NAudio.dll" DestinationFolder="$(PluginsDir)\LeAccess" Condition="Exists('$(TargetDir)NAudio.dll')" />
    <Copy SourceFiles="$(TargetDir)NAudio.Core.dll" DestinationFolder="$(PluginsDir)\LeAccess" Condition="Exists('$(TargetDir)NAudio.Core.dll')" />
    <Copy SourceFiles="$(TargetDir)NAudio.Wasapi.dll" DestinationFolder="$(PluginsDir)\LeAccess" Condition="Exists('$(TargetDir)NAudio.Wasapi.dll')" />
    <Copy SourceFiles="$(TargetDir)NAudio.WinMM.dll" DestinationFolder="$(PluginsDir)\LeAccess" Condition="Exists('$(TargetDir)NAudio.WinMM.dll')" />
  </Target>

</Project>
